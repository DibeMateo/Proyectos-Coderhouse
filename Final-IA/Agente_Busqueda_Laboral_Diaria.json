        "messages": {
          "values": [
            {
              "content": "=Actuás como mi asesor de búsqueda laboral. Mi perfil: Analista de Datos y Técnico en Programación, stack Python/SQL/Power BI/Excel/Tableau, certificaciones IBM Data Science y Data Analytics, inglés B1-B2, busco roles de análisis de datos, BI o administrativos. Evaluá la oferta y devolvé SOLO un JSON válido, sin texto extra: {\"score\": 0-100, \"motivo\": \"una frase breve\"} — y debajo, con variables dinámicas: Oferta: {{ $json.title }} / Empresa: {{ $json.company_name }} / Descripción: {{ $json.description }}."
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "maxOutputTokens": 300
        }
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        1104,
        -64
      ],
      "id": "a94ca678-a721-4a58-abe4-97d7ceb69091",
      "name": "Nodo IA: Score de Fit (Gemini).",
      "retryOnFail": true,
      "waitBetweenTries": 2000,
      "maxTries": 2,
      "credentials": {
        "googlePalmApi": {
          "id": "mi3GRbTTpo7aRPgG",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const jobs = $('Limitar ofertas por corrida').all();\nconst ai = $input.all();\nreturn ai.map((item, i) => {\n  const texto = item.json.content?.parts?.[0]?.text\n    ?? item.json.candidates?.[0]?.content?.parts?.[0]?.text\n    ?? item.json.text ?? '';\n  let score = 0, motivo = 'sin respuesta válida';\n  try {\n    if (item.json.error) { motivo = 'error de API: ' + item.json.error; }\n    const parsed = JSON.parse(texto.replace(/```json|```/g, '').trim());\n    score = Number(parsed.score);\n    motivo = parsed.motivo;\n  } catch (e) {}\n  const j = jobs[i].json;\n  return { json: { title: j.title, company_name: j.company_name, url: j.url, score, motivo } };\n});"
      },
