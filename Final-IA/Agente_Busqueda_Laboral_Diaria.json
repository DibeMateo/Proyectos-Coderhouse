    {
      "parameters": {
        "jsCode": "const ofertas = $('Code: Interpretar respuesta IA.').all()\n  .map(i => i.json)\n  .filter(o => o.score >= 50);\n\nconst count = ofertas.length;\nconst items = ofertas.map(o =>\n  `<li><b>${o.title}</b> — ${o.company_name} (Score: ${o.score}/100)<br>${o.motivo}<br><a href=\"${o.url}\">Ver oferta</a> — Fuente: Remotive</li>`\n).join('');\n\nconst htmlBody = `<h3>Ofertas de hoy (${count})</h3><ul>${items}</ul><p>Fuente: Remotive</p>`;\n\nreturn [{ json: { htmlBody, count } }];"
      },
