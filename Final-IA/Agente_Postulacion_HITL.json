    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const d = item.json;\n  const p = d.properties ?? {};\n\n  const titulo = p['Task name']?.title?.[0]?.plain_text ?? d['Task name'] ?? 'el puesto';\n  const url = p['Job URL']?.url ?? d['Job URL'] ?? '';\n\n  const carta = `Estimado equipo de reclutamiento:\n\nLes escribo para postularme al puesto de ${titulo}. Soy Analista de Datos y Técnico en Programación, con experiencia en Python, SQL, Power BI, Excel y Tableau, y certificaciones IBM en Data Science y Data Analytics. Me interesa aportar análisis y visualización de datos a su equipo.\n\nVi la oferta en: ${url}\n\nQuedo a disposición para una entrevista.\n\nSaludos,\nMateo Di Benedetto`;\n\n  return { json: { id: d.id, titulo, url, carta } };\n});"
      },
